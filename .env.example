# Copy to .env (gitignored) and fill in. Read only from this project's folder,
# never from the repository being gated.

# Which model API the agents call: "openai" (any OpenAI-compatible endpoint,
# such as Amazon Bedrock) or "anthropic".
GATE_PROVIDER=openai

# Bedrock OpenAI-compatible endpoint, e.g. https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PROJECT_ID=
MODEL_ID=openai.gpt-oss-120b

# How structured output is requested: json_schema (strict), json_object, or prompt.
# The client steps down automatically if the endpoint rejects a mode.
GATE_JSON_MODE=json_schema

# low | medium | high, sent as reasoning_effort. Leave empty to omit it.
GATE_REASONING_EFFORT=high

# Agent loop (openai provider): 0 = single call without tools.
GATE_AGENTIC=1
GATE_AGENT_MAX_TURNS=12
